# Required for the real backend. Never commit a real value.
KONTOMIERZ_API_KEY=

# Use deterministic in-memory data instead of the real service.
KONTOMIERZ_MOCK_DATA=0

# stdio is the safe default. Streamable HTTP is loopback-only and authenticated.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=9101

# Required only for Streamable HTTP. Generate a high-entropy ASCII token (32+ bytes).
MCP_HTTP_AUTH_TOKEN=
# Stable server-owned identity associated with the token; never accept this from a tool argument.
MCP_HTTP_PRINCIPAL=

# Mutations are denied unless the trusted operator enables this gate.
ENABLE_WRITE_OPERATIONS=0

KONTOMIERZ_API_BASE_URL=https://secure.kontomierz.pl/k4
KONTOMIERZ_API_TIMEOUT=30
# JSON is the currently observed behavior. Use form only as a bounded compatibility path.
KONTOMIERZ_BODY_MODE=json

# Running dependency calls and total admitted invocations (running + queued).
MCP_MAX_CONCURRENCY=8
MCP_MAX_PENDING_INVOCATIONS=16

# Cached mandatory-backend readiness probe.
MCP_READINESS_TIMEOUT=5
MCP_READINESS_CACHE_SECONDS=10
LOG_LEVEL=INFO
