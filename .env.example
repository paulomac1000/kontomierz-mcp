# Required for the real backend. Never commit a real value.
KONTOMIERZ_API_KEY=

# Use deterministic in-memory data instead of the real service.
KONTOMIERZ_MOCK_DATA=0

# stdio is the safe default. Streamable HTTP is loopback-only and authenticated.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=9101

# Required only for Streamable HTTP. Generate a high-entropy ASCII token (32+ bytes).
MCP_HTTP_AUTH_TOKEN=
# Stable server-owned identity associated with the token; never accept this from a tool argument.
MCP_HTTP_PRINCIPAL=
# HTTP principals are read-only by default. Add write/destructive only as an explicit server-side policy decision.
MCP_HTTP_ALLOWED_CAPABILITIES=read
# If destructive is enabled above, both narrow allowlists are mandatory. No wildcard resources are accepted.
# Example: destroy_wallet,delete_transaction
MCP_HTTP_ALLOWED_DESTRUCTIVE_CAPABILITIES=
# Exact resource identities only, e.g. wallet:123,transaction:456,budget:789,schedule:321
MCP_HTTP_ALLOWED_DESTRUCTIVE_RESOURCES=
# Request-body bound enforced by the MCP transport before dispatch (hard maximum: 4194304 bytes).
MCP_HTTP_MAX_REQUEST_BODY_BYTES=1048576

# Mutations also require this independent trusted operator gate.
ENABLE_WRITE_OPERATIONS=0

KONTOMIERZ_API_BASE_URL=https://secure.kontomierz.pl/k4
KONTOMIERZ_API_TIMEOUT=30
# JSON is the currently observed behavior. Use form only as a bounded compatibility path.
KONTOMIERZ_BODY_MODE=json

# Running dependency calls and total admitted invocations (running + queued).
MCP_MAX_CONCURRENCY=8
MCP_MAX_PENDING_INVOCATIONS=16

# Cached mandatory-backend readiness probe. /health/ready requires the same Bearer authentication as MCP HTTP.
MCP_READINESS_TIMEOUT=5
MCP_READINESS_CACHE_SECONDS=10
# General application verbosity. The structured audit sink remains INFO-capable independently of this value.
LOG_LEVEL=INFO
